{
  "name": "adsoftwash-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NEXT_DISABLE_TURBOPACK=1&& next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "npm run catalog:check && node --test --experimental-strip-types tests/*.test.mts",
    "test:auth:provision": "node scripts/provision-test-auth.mjs",
    "test:staging:verify": "node scripts/verify-hosted-staging.mjs",
    "catalog:generate": "node scripts/generate-bin-cleaning-catalog.mjs",
    "catalog:check": "node scripts/generate-bin-cleaning-catalog.mjs --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "14.2.16",
    "nodemailer": "^6.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.16",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
