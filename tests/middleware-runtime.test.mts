import assert from "node:assert/strict";import test from "node:test";import { NextRequest } from "next/server.js";import { middleware } from "../src/middleware.ts";
test("anonymous direct portal URL redirects to login",async()=>{const response=await middleware(new NextRequest("http://localhost:3000/bin-cleaning/portal"));assert.equal(response.status,307);assert.match(response.headers.get("location")??"",/bin-cleaning\/login\?next=%2Fbin-cleaning%2Fportal/)});
test("anonymous direct CRM customer URL redirects to login",async()=>{const response=await middleware(new NextRequest("http://localhost:3000/bin-cleaning/crm/customers/id"));assert.equal(response.status,307);assert.match(response.headers.get("location")??"",/bin-cleaning\/login/)});
test("anonymous direct field URL redirects to login",async()=>{const response=await middleware(new NextRequest("http://localhost:3000/bin-cleaning/field/visits/id"));assert.equal(response.status,307);assert.match(response.headers.get("location")??"",/bin-cleaning\/login/)});
