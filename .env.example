# LOCAL OR HOSTED TEST VALUES ONLY. Never place production credentials in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# development | test | staging | production
NEXT_PUBLIC_APP_ENV=test
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted staging verification only. Keep the password in a protected secret store.
STAGING_APP_URL=
ADS_STAGING_TEST_PASSWORD=

# Step 3 protected test integration modes.
# Use simulator until a provider and protected test credential are deliberately connected.
ADDRESS_VALIDATION_MODE=simulator
ADDRESS_VALIDATION_API_KEY=
TAX_CALCULATION_MODE=simulator
TAX_PROVIDER_API_KEY=
NOTIFICATION_MODE=simulator
TEST_EMAIL_API_KEY=
TEST_SMS_API_KEY=

# Stripe TEST MODE ONLY. Keep disabled in source-controlled examples.
# Set STRIPE_INTEGRATION_MODE=test only in a protected Preview environment after
# installing sk_test_/whsec_ credentials and the TEST coupon IDs below.
# The server refuses sk_live_ credentials while mode=test.
STRIPE_INTEGRATION_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_COUPON_NEW25=
STRIPE_TEST_COUPON_REFERRAL50=
STRIPE_TEST_COUPON_ONE45=

# Unique disposable local value, supplied at runtime to scripts/provision-test-auth.mjs only.
ADS_TEST_USER_PASSWORD=
